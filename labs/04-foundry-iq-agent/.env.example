# Environment Configuration
# Copy this file to .env and fill in your actual values

# Microsoft Foundry Project Endpoint
# Get this from the Foundry project (see labs/01-build-agent README)
PROJECT_ENDPOINT=https://<foundry-account>.services.ai.azure.com/api/projects/<project>

# Agent name (created via create_agent.py)
AGENT_NAME=product-expert-agent

# --- Foundry IQ (values from 001-deploy-search) ---
# Retrieve with the az commands in the header of 001-deploy-search/main.bicep.
# API keys are a demo shortcut; keyless (Entra ID + RBAC) is preferred in production.
SEARCH_ENDPOINT=https://<search-service>.search.windows.net
SEARCH_API_KEY=
STORAGE_CONNECTION_STRING=
FOUNDRY_OPENAI_ENDPOINT=https://<foundry-account>.openai.azure.com
FOUNDRY_API_KEY=

# Optional overrides (defaults shown)
# STORAGE_CONTAINER=contosoproducts
# KNOWLEDGE_SOURCE_NAME=ks-contosoproducts
# KNOWLEDGE_BASE_NAME=kb-contosoproducts
# MCP_CONNECTION_NAME=kb-contosoproducts-mcp
# EMBEDDING_DEPLOYMENT=text-embedding-3-small-dev-001
# EMBEDDING_MODEL=text-embedding-3-small

# Optional knowledge base chat model for query planning; must be supported by
# Foundry IQ (e.g. gpt-5-mini). Without it, retrieval uses minimal reasoning.
# CHAT_DEPLOYMENT=
# CHAT_MODEL=
